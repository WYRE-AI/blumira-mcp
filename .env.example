# Blumira API JWT Token (required for stdio and for AUTH_MODE=env)
BLUMIRA_JWT_TOKEN=your-jwt-token-here

# Transport: stdio (default) or http
# MCP_TRANSPORT=http
# MCP_HTTP_PORT=8080
# Bind address when MCP_TRANSPORT=http. Defaults to 127.0.0.1.
# The container image sets MCP_HTTP_HOST=0.0.0.0 explicitly.
# MCP_HTTP_HOST=127.0.0.1

# Required for HTTP (MCP_TRANSPORT=http). Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (so a copied
# example cannot forge X-Gateway-S2S). docker compose will not start if it
# is unset or empty. Never commit a real secret. The value is never logged.
# Local development only: MCP_ALLOW_INSECURE_DEV=1 starts HTTP without this
# secret, logs a warning, skips X-Gateway-S2S, and binds 127.0.0.1 only.
# A non-loopback MCP_HTTP_HOST is refused in that mode.
CONDUIT_S2S_SECRET=
# MCP_ALLOW_INSECURE_DEV=1

# Auth mode: env (stdio / single-tenant HTTP) or gateway (per-request headers).
# The Docker image and compose file default to gateway. In gateway mode, /mcp
# returns 401 when vendor credential headers are missing and never falls back
# to process environment credentials.
# AUTH_MODE=gateway

# Logging
# LOG_LEVEL=info
